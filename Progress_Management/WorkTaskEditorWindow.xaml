<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Progress_Management.WorkTaskEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WorkTask Editor"
    PrimaryButtonText="保存"
    SecondaryButtonText="キャンセル"
    PrimaryButtonClick="SaveButton_Click"
    SecondaryButtonClick="CancelButton_Click"
    DefaultButton="Primary">

    <Grid Padding="4" RowDefinitions="Auto,*" RowSpacing="14" Background="#F6F7F4" MinWidth="660" MaxHeight="720">
        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleTextBlock" Text="作業タスク入力" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ModeTextBlock" Foreground="#657168" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="140,*" RowSpacing="10" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="作業ID" VerticalAlignment="Center" />
                <TextBox x:Name="IdTextBox" Grid.Column="1" />

                <TextBlock Grid.Row="1" Text="シナリオ" VerticalAlignment="Center" />
                <ComboBox x:Name="ScenarioComboBox" Grid.Row="1" Grid.Column="1" />

                <TextBlock Grid.Row="2" Text="作業名" VerticalAlignment="Center" />
                <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" />

                <TextBlock Grid.Row="3" Text="担当者" VerticalAlignment="Center" />
                <ComboBox x:Name="WorkerComboBox" Grid.Row="3" Grid.Column="1" />

                <TextBlock Grid.Row="4" Text="難易度" VerticalAlignment="Center" />
                <NumberBox x:Name="DifficultyNumberBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="5" SpinButtonPlacementMode="Inline" />

                <TextBlock Grid.Row="5" Text="予定作業量" VerticalAlignment="Center" />
                <NumberBox x:Name="PlannedWorkloadNumberBox" Grid.Row="5" Grid.Column="1" Minimum="0" SpinButtonPlacementMode="Inline" />

                <TextBlock Grid.Row="6" Text="実績作業量" VerticalAlignment="Center" />
                <NumberBox x:Name="ActualWorkloadNumberBox" Grid.Row="6" Grid.Column="1" Minimum="0" SpinButtonPlacementMode="Inline" />

                <TextBlock Grid.Row="7" Text="単位" VerticalAlignment="Center" />
                <TextBox x:Name="OutputUnitTextBox" Grid.Row="7" Grid.Column="1" />

                <TextBlock Grid.Row="8" Text="当初予定" VerticalAlignment="Center" />
                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="BaselineStartTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="BaselineStartPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                    <TextBlock Text="から" VerticalAlignment="Center" />
                    <TextBox x:Name="BaselineEndTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="BaselineEndPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                </StackPanel>

                <TextBlock Grid.Row="9" Text="リスケ後予定" VerticalAlignment="Center" />
                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RevisedStartTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="RevisedStartPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                    <TextBlock Text="から" VerticalAlignment="Center" />
                    <TextBox x:Name="RevisedEndTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="RevisedEndPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                    <CheckBox x:Name="RevisedScheduleOptionalCheckBox" Content="省略可" VerticalAlignment="Center" Checked="OnRevisedScheduleOptionalChanged" Unchecked="OnRevisedScheduleOptionalChanged" />
                </StackPanel>

                <TextBlock Grid.Row="10" Text="実績" VerticalAlignment="Center" />
                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ActualStartTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="ActualStartPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                    <TextBlock Text="から" VerticalAlignment="Center" />
                    <TextBox x:Name="ActualEndTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="ActualEndPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                </StackPanel>

                <TextBlock Grid.Row="11" Text="再スケ提案" VerticalAlignment="Center" />
                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ProposalStartTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="ProposalStartPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                    <TextBlock Text="から" VerticalAlignment="Center" />
                    <TextBox x:Name="ProposalEndTextBox" Width="100" PlaceholderText="yyyy/MM/dd" IsReadOnly="True" />
                    <CalendarDatePicker x:Name="ProposalEndPicker" Width="50" PlaceholderText="📅" Language="ja-JP" DateChanged="OnDateChanged" />
                </StackPanel>

                <TextBlock Grid.Row="12" Text="状態" VerticalAlignment="Center" />
                <ComboBox x:Name="StatusComboBox" Grid.Row="12" Grid.Column="1" />

                <TextBlock Grid.Row="13" Text="先行タスク" VerticalAlignment="Center" />
                <TextBox x:Name="PredecessorTaskIdsTextBox" Grid.Row="13" Grid.Column="1" PlaceholderText="例: T-100, T-110" />

                <TextBlock Grid.Row="14" Text="後続タスク" VerticalAlignment="Center" />
                <TextBox x:Name="SuccessorTaskIdsTextBox" Grid.Row="14" Grid.Column="1" PlaceholderText="例: T-120" />

                <TextBlock Grid.Row="15" Text="表示順" VerticalAlignment="Center" />
                <NumberBox x:Name="SortOrderNumberBox" Grid.Row="15" Grid.Column="1" Minimum="0" SpinButtonPlacementMode="Inline" />

                <TextBlock Grid.Row="16" Text="メモ" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox x:Name="NoteTextBox" Grid.Row="16" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

                <TextBlock x:Name="MessageTextBlock" Grid.Row="17" Grid.ColumnSpan="2" Foreground="#C94949" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>
    </Grid>
</ContentDialog>
